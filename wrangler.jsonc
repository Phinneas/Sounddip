{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sounddip",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "d1_databases": [
    {
      "binding": "QUERY_LOG",
      "database_name": "sounddip-query-logs",
      "database_id": "b9151a7f-b1e0-4063-8089-636a80b1eec7"
    }
  ]
}

---
import Layout from './Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
}

const { title, description, pubDate, updatedDate, author } = Astro.props;
const siteUrl = 'https://sounddip.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<JsonLd data={{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  "dateModified": (updatedDate || pubDate).toISOString(),
  "author": { "@type": "Organization", "name": author },
  "publisher": { "@type": "Organization", "name": "Sound Dip", "url": siteUrl },
  "mainEntityOfPage": canonicalURL,
}} />

<Layout title={`${title} — Sound Dip`} description={description} canonical={Astro.url.pathname}>
  <Topbar />
  <main>
    <article class="blog-post">
      <header class="blog-header">
        <div class="blog-meta">
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
          {updatedDate && (
            <span class="updated">· Updated {fmtDate(updatedDate)}</span>
          )}
        </div>
        <h1>{title}</h1>
        <p class="blog-lede">{description}</p>
      </header>

      <div class="blog-body">
        <slot />
      </div>

      <footer class="blog-footer">
        <a href="/blog" class="back-link">← Back to all articles</a>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .blog-post {
    max-width: 720px;
    margin: 0 auto;
    padding: 140px 6vw 80px;
  }

  .blog-meta {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 24px;
  }
  .blog-meta .updated { color: var(--clay); }

  .blog-header h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: var(--ink);
    margin-bottom: 24px;
    font-variation-settings: "opsz" 144;
  }

  .blog-lede {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 22px;
    color: var(--ink-mid);
    line-height: 1.4;
    margin-bottom: 56px;
    font-variation-settings: "opsz" 72;
  }

  .blog-body {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--ink);
    font-variation-settings: "opsz" 72;
  }

  .blog-body h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    color: var(--ink);
    margin-top: 56px;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
    font-variation-settings: "opsz" 144;
  }

  .blog-body h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 22px;
    color: var(--ink);
    margin-top: 40px;
    margin-bottom: 16px;
  }

  .blog-body p {
    margin-bottom: 24px;
  }

  .blog-body a {
    color: var(--clay);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }
  .blog-body a:hover { color: var(--clay-d); }

  .blog-body ul, .blog-body ol {
    margin-bottom: 24px;
    padding-left: 24px;
  }

  .blog-body li {
    margin-bottom: 12px;
  }

  .blog-body img {
    width: 100%;
    height: auto;
    border-radius: 24px;
    margin: 40px 0;
  }

  .blog-body blockquote {
    border-left: 3px solid var(--clay);
    padding-left: 24px;
    margin: 32px 0;
    font-style: italic;
    color: var(--ink-mid);
  }

  .blog-body strong {
    font-weight: 500;
  }

  .blog-footer {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }

  .back-link {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--clay);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--clay-d); }

  @media (max-width: 640px) {
    .blog-post { padding: 100px 6vw 60px; }
    .blog-body { font-size: 17px; }
  }
</style>

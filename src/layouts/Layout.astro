---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /**
   * Emits `noindex,nofollow`. Used for city pages that fall below the inventory
   * threshold — they stay reachable and keep their editorial copy for relaunch,
   * but drop out of the index.
   *
   * Never pair this with a robots.txt Disallow for the same path: Google cannot
   * read a noindex meta tag on a page it is blocked from crawling, so the URL
   * stays indexed with no signal attached.
   */
  noindex?: boolean;
}
const {
  title = 'Sound Dip — A directory of sound',
  description = 'Find sound bath sessions, verified practitioners, and the rooms that hold them.',
  canonical,
  noindex = false,
} = Astro.props;
const siteUrl = 'https://www.sounddip.com';
const canonicalURL = canonical ? `${siteUrl}${canonical}` : siteUrl;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-adsense-account" content="ca-pub-5424097145643842" />
  <meta name="google-site-verification" content="HqlHA3hrWdUgDcGJ-_wGpLJ6QCg4Xg4NjskX-5jK5I4" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Sound Dip" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

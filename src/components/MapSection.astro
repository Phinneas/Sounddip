---
// MapSection — homepage "i. Sessions near you": the working ZIP + radius map.
// The map itself lives in NearbyMap.astro (shared with /find-your-dip).
import NearbyMap from './NearbyMap.astro';
---

<section class="section">
  <div class="section-head">
    <div class="section-num">i.</div>
    <div class="section-title">Sessions near <em>you.</em></div>
    <div class="section-meta">
      <strong>By ZIP code</strong>
      25 / 50 / 100 miles
    </div>
  </div>
  <NearbyMap lede="Enter your ZIP code to see verified sound bath sessions within driving distance." />
</section>

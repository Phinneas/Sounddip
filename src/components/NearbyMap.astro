---
// NearbyMap — reusable "sessions near you" map: ZIP input, 25/50/100-mile
// radius, a map with markers, and a results list. No external API key: the map
// uses MapLibre GL + OpenStreetMap tiles, the ZIP lookup uses Zippopotam, and
// listing coordinates come from /listings.geo.json (generated by
// scripts/geocode-listings.mjs via Nominatim).
interface Props {
  lede?: string;
}
const { lede = 'Enter your ZIP code to see verified sound bath sessions within driving distance.' } = Astro.props;
---

<div class="nearby" id="nearby">
  {lede && <p class="nearby-lede">{lede}</p>}

  <form class="nearby-form" id="nearby-form" autocomplete="off">
    <input
      class="nearby-zip"
      id="nearby-zip"
      type="text"
      inputmode="numeric"
      pattern="[0-9]{5}"
      maxlength="5"
      placeholder="ZIP code"
      aria-label="ZIP code"
      autocomplete="postal-code"
    />
    <div class="nearby-radii" id="nearby-radii" role="group" aria-label="Search radius">
      <button type="button" class="nearby-radius" data-radius="25">25 mi</button>
      <button type="button" class="nearby-radius active" data-radius="50">50 mi</button>
      <button type="button" class="nearby-radius" data-radius="100">100 mi</button>
    </div>
    <button type="submit" class="nearby-submit">Search</button>
  </form>

  <div class="nearby-map" id="nearby-map"></div>
  <p class="nearby-status" id="nearby-status" role="status" hidden></p>
  <div class="nearby-results" id="nearby-results"></div>
</div>

<style>
  .nearby-lede {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    color: var(--ink-mid);
    max-width: 720px;
    margin-bottom: 28px;
    line-height: 1.4;
    font-variation-settings: "opsz" 72;
  }
  .nearby-form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    max-width: 720px;
    margin-bottom: 32px;
  }
  .nearby-zip {
    flex: 0 0 160px;
    padding: 14px 18px;
    border: 1px solid var(--rule);
    border-radius: 100px;
    background: var(--bone-2);
    font-family: var(--mono);
    font-size: 15px;
    letter-spacing: 1px;
    color: var(--ink);
    transition: border-color 0.2s;
  }
  .nearby-zip:focus { border-color: var(--clay); outline: none; }
  .nearby-zip::placeholder { color: var(--ink-soft); letter-spacing: 1px; }

  .nearby-radii {
    display: flex;
    border: 1px solid var(--rule);
    border-radius: 100px;
    overflow: hidden;
  }
  .nearby-radius {
    padding: 14px 20px;
    border: none;
    background: var(--bone);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink-mid);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .nearby-radius + .nearby-radius { border-left: 1px solid var(--rule); }
  .nearby-radius.active { background: var(--ink); color: var(--bone); }

  .nearby-submit {
    padding: 14px 28px;
    border: none;
    border-radius: 100px;
    background: var(--clay);
    color: var(--bone);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .nearby-submit:hover { background: var(--clay-d); }

  .nearby-map {
    width: 100%;
    height: 480px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--linen);
    box-shadow: var(--shadow);
    margin-bottom: 16px;
  }

  .nearby-status {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-mid);
    margin-bottom: 24px;
    font-variation-settings: "opsz" 72;
  }

  .nearby-results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .nearby-card {
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--bone-2);
  }
  .nearby-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 6px;
  }
  .nearby-card-name {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--ink);
    letter-spacing: -0.3px;
    font-variation-settings: "opsz" 72;
  }
  .nearby-card-miles {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--clay);
    white-space: nowrap;
  }
  .nearby-card-loc {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 10px;
  }
  .nearby-card-desc {
    font-family: var(--serif);
    font-size: 14px;
    color: var(--ink-mid);
    line-height: 1.55;
    margin-bottom: 12px;
    font-variation-settings: "opsz" 72;
  }
  .nearby-card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.5px;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .nearby-card-book {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--clay);
    text-decoration: none;
  }
  .nearby-card-book:hover { color: var(--clay-d); }
  .nearby-empty {
    grid-column: 1 / -1;
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-soft);
    font-variation-settings: "opsz" 72;
  }

  .nearby-marker {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--clay);
    border: 3px solid var(--bone);
    box-shadow: 0 0 0 1px rgba(34, 27, 19, 0.25), 0 2px 6px rgba(34, 27, 19, 0.3);
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .nearby-form { flex-direction: column; align-items: stretch; }
    .nearby-zip { flex: none; }
    .nearby-radii { align-self: center; }
    .nearby-map { height: 360px; }
  }
</style>

<script>
  const MAPLIBRE_JS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js';
  const MAPLIBRE_CSS = 'https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css';
  const GEO_JSON_URL = '/listings.geo.json';

  const root = document.getElementById('nearby');
  const mapEl = document.getElementById('nearby-map');
  const form = document.getElementById('nearby-form');
  const zipInput = document.getElementById('nearby-zip');
  const resultsEl = document.getElementById('nearby-results');
  const statusEl = document.getElementById('nearby-status');
  const radiusButtons = Array.from(document.querySelectorAll('.nearby-radius'));

  let map = null;
  let maplibregl = null;
  let radius = 50;
  let listings = [];
  let currentMarkers = [];

  const escapeHtml = (s) =>
    String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  function milesBetween(a, b) {
    const R = 3958.8; // Earth radius in miles
    const toRad = (d) => (d * Math.PI) / 180;
    const dLat = toRad(b.lat - a.lat);
    const dLng = toRad(b.lng - a.lng);
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * Math.sin(dLng / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(h));
  }

  function setStatus(msg) {
    if (!msg) { statusEl.hidden = true; statusEl.textContent = ''; return; }
    statusEl.hidden = false;
    statusEl.textContent = msg;
  }

  async function loadMapLibre() {
    if (window.maplibregl) return window.maplibregl;
    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = MAPLIBRE_CSS;
    document.head.appendChild(css);
    await new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = MAPLIBRE_JS;
      s.onload = resolve;
      s.onerror = () => reject(new Error('MapLibre failed to load'));
      document.head.appendChild(s);
    });
    return window.maplibregl;
  }

  async function initMap() {
    if (!mapEl) return;
    try {
      maplibregl = await loadMapLibre();
    } catch {
      setStatus('The map could not be loaded.');
      return;
    }
    map = new maplibregl.Map({
      container: mapEl,
      style: {
        version: 8,
        sources: {
          osm: {
            type: 'raster',
            tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],
            tileSize: 256,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
          },
        },
        layers: [{ id: 'osm', type: 'raster', source: 'osm' }],
      },
      center: [-98.5, 39.5],
      zoom: 3.2,
      scrollZoom: true,
    });
    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  }

  // ZIP -> lat/lng via Zippopotam (free, no key).
  async function geocodeZip(zip) {
    const url = `https://api.zippopotam.us/us/${encodeURIComponent(zip)}`;
    const res = await fetch(url);
    if (!res.ok) return null;
    const data = await res.json();
    const p = data.places && data.places[0];
    if (!p) return null;
    return { lat: parseFloat(p.latitude), lng: parseFloat(p.longitude), place: `${p['place name']}, ${p.state}` };
  }

  async function loadListings() {
    try {
      const res = await fetch(GEO_JSON_URL, { cache: 'no-store' });
      if (!res.ok) return [];
      return await res.json();
    } catch {
      return [];
    }
  }

  function clearMarkers() {
    currentMarkers.forEach((m) => m.remove());
    currentMarkers = [];
  }

  function updateMap(nearby) {
    if (!map || !maplibregl) return;
    clearMarkers();
    nearby.forEach((l) => {
      const el = document.createElement('div');
      el.className = 'nearby-marker';
      const marker = new maplibregl.Marker({ element: el, anchor: 'center' })
        .setLngLat([l.lng, l.lat])
        .addTo(map);
      const popupHtml = `<div style="font-family:Inter,sans-serif;max-width:220px">
        <strong style="font-size:14px">${escapeHtml(l.name)}</strong>
        <div style="font-size:12px;color:#5a4f43">${escapeHtml(l.city)}</div>
        ${l.bookingUrl && l.bookingUrl !== 'N/A' ? `<a href="${escapeHtml(l.bookingUrl)}" target="_blank" rel="noopener noreferrer" style="font-size:12px;color:#9a5a39">Book a session ↗</a>` : ''}
      </div>`;
      marker.setPopup(new maplibregl.Popup({ offset: 24 }).setHTML(popupHtml));
      currentMarkers.push(marker);
    });
  }

  function renderResults(nearby) {
    if (!nearby.length) {
      resultsEl.innerHTML = '<p class="nearby-empty">No sessions found in this radius. Try a wider search.</p>';
      return;
    }
    resultsEl.innerHTML = nearby.map((l) => {
      const loc = [l.neighborhood, l.city].filter(Boolean).join(' · ');
      const meta = [l.price, l.duration].filter((v) => v && v !== 'Not published').join(' · ');
      return `
        <div class="nearby-card">
          <div class="nearby-card-head">
            <span class="nearby-card-name">${escapeHtml(l.name)}</span>
            <span class="nearby-card-miles">${Math.round(l.distance)} mi</span>
          </div>
          <div class="nearby-card-loc">${escapeHtml(loc)}</div>
          ${l.sessionDescription ? `<p class="nearby-card-desc">${escapeHtml(l.sessionDescription)}</p>` : ''}
          ${meta ? `<div class="nearby-card-meta">${escapeHtml(meta)}</div>` : ''}
          ${l.bookingUrl && l.bookingUrl !== 'N/A' ? `<a class="nearby-card-book" href="${escapeHtml(l.bookingUrl)}" target="_blank" rel="noopener noreferrer">Book a session ↗</a>` : ''}
        </div>`;
    }).join('');
  }

  async function doSearch() {
    const zip = zipInput.value.trim();
    if (!/^\d{5}$/.test(zip)) { setStatus('Enter a 5-digit ZIP code.'); return; }
    setStatus('Searching…');
    const coords = await geocodeZip(zip);
    if (!coords) { setStatus('Could not find that ZIP code. Try another.'); return; }
    const nearby = listings
      .map((l) => ({ ...l, distance: milesBetween(coords, l) }))
      .filter((l) => l.distance <= radius)
      .sort((a, b) => a.distance - b.distance);
    renderResults(nearby);
    updateMap(nearby);
    if (map) {
      const zoom = radius === 25 ? 8 : radius === 50 ? 7 : 6;
      map.flyTo({ center: [coords.lng, coords.lat], zoom, essential: true });
    }
    const n = nearby.length;
    setStatus(n
      ? `${n} session${n === 1 ? '' : 's'} within ${radius} miles of ${coords.place}.`
      : `No sessions within ${radius} miles of ${coords.place}. Try a wider radius.`);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); doSearch(); });

  radiusButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      radiusButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      radius = Number(btn.dataset.radius);
    });
  });

  // Support /?zip=98201&radius=25 deep links, and load data + map on page load.
  async function init() {
    await initMap();
    listings = await loadListings();
    const params = new URLSearchParams(window.location.search);
    const qZip = params.get('zip');
    const qRadius = params.get('radius');
    if (qZip) {
      zipInput.value = qZip;
      if (qRadius && ['25', '50', '100'].includes(qRadius)) {
        radius = Number(qRadius);
        radiusButtons.forEach((b) => b.classList.toggle('active', Number(b.dataset.radius) === radius));
      }
      doSearch();
    }
  }

  init();
</script>

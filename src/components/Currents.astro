---
// Currents — newsletter signup, wired to the real NourishedJourneys Substack.
const SUBSTACK_URL = 'https://nourishedjourneys.substack.com/';
---

<section class="currents">
  <div class="currents-eyebrow">NourishedJourneys</div>
  <h2>A weekly tide of new <em>sessions</em>, by post.</h2>
  <p>One email a week from the NourishedJourneys newsletter — featured sessions, new practitioners, and one essay on the practice. No noise.</p>
  <a class="currents-btn" href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">
    Subscribe on Substack <span aria-hidden="true">↗</span>
  </a>
  <div class="currents-fineprint">No spam · Unsubscribe at any time</div>
</section>

<style>
  .currents {
    max-width: 1440px;
    margin: 0 auto;
    padding: 160px 6vw 100px;
    text-align: center;
  }
  .currents-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--crimson);
    margin-bottom: 28px;
    display: inline-block;
  }
  .currents-eyebrow::before,
  .currents-eyebrow::after { content: "—"; margin: 0 12px; color: var(--crimson); }
  .currents h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(48px, 6.5vw, 88px);
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--ink);
    max-width: 840px;
    margin: 0 auto 24px;
    font-variation-settings: "opsz" 144;
  }
  .currents h2 em { font-style: italic; color: var(--crimson); }
  .currents p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink-mid);
    max-width: 560px;
    margin: 0 auto 40px;
    line-height: 1.4;
    font-variation-settings: "opsz" 72;
  }
  .currents-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 100px;
    text-decoration: none;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.2px;
    transition: background 0.2s;
  }
  .currents-btn:hover { background: var(--crimson); }
  .currents-fineprint {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 24px;
  }
</style>

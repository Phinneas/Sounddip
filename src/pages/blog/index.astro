---
import Layout from '../../layouts/Layout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Articles — Sound Dip"
  description="Research-backed guides on sound healing, sound baths, and what the evidence actually says."
>
  <Topbar />
  <main>
    <section class="blog-index">
      <header class="blog-index-head">
        <div class="blog-index-num">§</div>
        <h1>Articles</h1>
        <p class="blog-index-sub">Research-backed guides on sound healing, sound baths, and what the evidence actually says.</p>
      </header>

      <div class="blog-list">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="blog-card">
            <div class="blog-card-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {fmtDate(post.data.pubDate)}
              </time>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .blog-index {
    max-width: 800px;
    margin: 0 auto;
    padding: 140px 6vw 80px;
  }

  .blog-index-head {
    margin-bottom: 80px;
  }

  .blog-index-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 48px;
    color: var(--clay);
    line-height: 0.8;
    margin-bottom: 24px;
  }

  .blog-index-head h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--ink);
    margin-bottom: 24px;
    font-variation-settings: "opsz" 144;
  }

  .blog-index-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink-mid);
    line-height: 1.4;
    font-variation-settings: "opsz" 72;
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .blog-card {
    display: block;
    padding: 40px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: padding 0.2s;
  }
  .blog-card:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .blog-card:hover {
    padding-left: 12px;
  }

  .blog-card-meta {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }

  .blog-card h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.2;
    color: var(--ink);
    margin-bottom: 12px;
    letter-spacing: -0.5px;
    font-variation-settings: "opsz" 144;
  }

  .blog-card p {
    font-family: var(--serif);
    font-size: 17px;
    color: var(--ink-mid);
    line-height: 1.5;
    font-variation-settings: "opsz" 72;
  }

  .blog-card:hover h2 { color: var(--clay); }

  @media (max-width: 640px) {
    .blog-index { padding: 100px 6vw 60px; }
    .blog-card h2 { font-size: 22px; }
  }
</style>

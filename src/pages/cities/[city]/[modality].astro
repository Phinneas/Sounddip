---
// Retired /cities/[city]/[modality] long-tail pages.
// No pages are built for this route; it serves HTTP 410 (Gone) on-demand so any
// previously-published URLs de-index cleanly instead of 404ing. Relaunch criteria
// (≥3 visible listings, linked from the city page) live in REDESIGN-SCOPE.md.
export const prerender = false;
Astro.response.status = 410;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Gone — Sound Dip</title>
  <style>
    body {
      margin: 0;
      font-family: 'Hanken Grotesk', system-ui, sans-serif;
      background: #FAFAFA;
      color: #1C0A14;
      display: grid;
      place-items: center;
      min-height: 100vh;
    }
    .box { max-width: 480px; padding: 48px 24px; text-align: center; }
    h1 { font-family: 'Newsreader', Georgia, serif; font-weight: 300; font-size: 40px; margin: 0 0 16px; }
    p { color: #5E5560; line-height: 1.6; margin: 0 0 24px; }
    a { color: #9A031E; }
  </style>
</head>
<body>
  <div class="box">
    <h1>This page is gone.</h1>
    <p>That city and modality combination is no longer listed here. Browse the full directory instead.</p>
    <a href="/cities/">Browse all cities →</a>
  </div>
</body>
</html>

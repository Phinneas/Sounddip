---
import Layout from '../../layouts/Layout.astro';
import Topbar from '../../components/Topbar.astro';
import Footer from '../../components/Footer.astro';
import { cities } from '../../data/cities';

// Sorted alphabetically for a clean directory index.
const sorted = [...cities].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title="All Cities — Sound Dip"
  description="Browse every city in the Sound Dip sound bath directory."
  canonical="/cities"
>
  <main>
    <Topbar />
    <section class="cities-index">
      <header class="cities-index-head">
        <div class="cities-index-num">iii.</div>
        <h1>All <em>cities.</em></h1>
        <p class="cities-index-sub">Every city in the directory, from the deepest scenes to the ones just getting started.</p>
      </header>

      <div class="cities-index-list">
        {sorted.map((city) => (
          <a href={`/cities/${city.slug}/`} class="cities-index-row">
            <span class="cities-index-name">{city.name}</span>
            <span class="cities-index-region">{city.region}</span>
          </a>
        ))}
      </div>
    </section>
    <Footer />
  </main>
</Layout>

<style>
  .cities-index {
    max-width: 800px;
    margin: 0 auto;
    padding: 140px 6vw 80px;
  }
  .cities-index-head { margin-bottom: 64px; }
  .cities-index-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 48px;
    color: var(--clay);
    line-height: 0.8;
    margin-bottom: 24px;
  }
  .cities-index-head h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--ink);
    margin-bottom: 24px;
    font-variation-settings: "opsz" 144;
  }
  .cities-index-head h1 em { font-style: italic; color: var(--clay); }
  .cities-index-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink-mid);
    line-height: 1.4;
    font-variation-settings: "opsz" 72;
  }
  .cities-index-list {
    display: flex;
    flex-direction: column;
  }
  .cities-index-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: padding 0.2s;
  }
  .cities-index-row:last-child { border-bottom: 1px solid var(--rule); }
  .cities-index-row:hover { padding-left: 12px; }
  .cities-index-name {
    font-family: var(--serif);
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.3px;
    font-variation-settings: "opsz" 72;
  }
  .cities-index-row:hover .cities-index-name { color: var(--clay); }
  .cities-index-region {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-align: right;
  }
  @media (max-width: 640px) {
    .cities-index { padding: 100px 6vw 60px; }
    .cities-index-name { font-size: 19px; }
  }
</style>

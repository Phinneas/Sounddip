---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';

const pageTitle = 'Find Your Sound Bath — Sound Dip';
const pageDescription = "Answer five questions about your experience, what you're seeking, setting, budget, and location. We'll match you to sound bath sessions that fit.";

// Static fallback cities — the client-side script fetches the full list from the CMS at runtime
const pilotCities = [
  { name: 'Los Angeles', slug: 'los-angeles' },
  { name: 'New York City', slug: 'new-york' },
  { name: 'Chicago', slug: 'chicago' },
  { name: 'Austin', slug: 'austin' },
  { name: 'San Francisco', slug: 'san-francisco' },
  { name: 'Seattle', slug: 'seattle' },
  { name: 'Portland', slug: 'portland' },
  { name: 'Denver', slug: 'denver' },
  { name: 'Miami', slug: 'miami' },
  { name: 'Sedona', slug: 'sedona' },
  { name: 'Joshua Tree', slug: 'joshua-tree' },
  { name: 'Boulder', slug: 'boulder' },
  { name: 'Asheville', slug: 'asheville' },
  { name: 'San Diego', slug: 'san-diego' },
  { name: 'Boston', slug: 'boston' },
  { name: 'Santa Fe', slug: 'santa-fe' },
  { name: 'Minneapolis', slug: 'minneapolis' },
  { name: 'Washington', slug: 'washington-dc' },
  { name: 'New Orleans', slug: 'new-orleans' },
  { name: 'Burlington', slug: 'burlington' },
];
---

<JsonLd data={{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I know which sound bath is right for me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your experience level, what you're seeking (rest, emotional release, curiosity, something spiritual), preferred setting (group, small, private, outdoor), budget, and location all matter. This quiz uses those five factors to match you with sessions that fit."
      }
    },
    {
      "@type": "Question",
      "name": "What should I expect at my first sound bath?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You lie down, close your eyes, and let vibrations from bowls, gongs, and voice wash over you for about an hour. Most people fall asleep at least a little. No movement, chanting, or effort is required. Mats and blankets are typically provided."
      }
    },
    {
      "@type": "Question",
      "name": "How much does a sound bath cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Group sessions in most US cities range from $15 to $60. Private sessions can run $100 to $300. Several cities have free or donation-based community sessions. The quiz filters by your budget."
      }
    },
    {
      "@type": "Question",
      "name": "What instruments are used in a sound bath?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Crystal singing bowls, gongs, Tibetan or Himalayan bowls, voice, and sometimes breathwork, Reiki, frame drums, handpans, or chimes. Different instruments produce different experiences — gongs tend to be more intense, crystal bowls more restful."
      }
    },
    {
      "@type": "Question",
      "name": "Can I attend a sound bath if I've never done meditation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Sound baths require no meditation experience. You simply lie down and listen. Many practitioners offer introductory sessions specifically designed for first-timers."
      }
    },
  ]
}} />

<Layout title={pageTitle} description={pageDescription} canonical="/find-your-dip">
  <Topbar />
  <main>
    <!-- ── Static intro (SEO indexable) ── -->
    <section class="quiz-intro">
      <div class="quiz-intro-eyebrow">Find your dip</div>
      <h1>Which sound bath <em>fits?</em></h1>
      <p class="quiz-intro-sub">
        Five questions. No email required. We'll match you to real sessions with booking links,
        not a generic list. The more honest you are, the better the fit.
      </p>
    </section>

    <!-- ── Quiz section (one question at a time, client-side) ── -->
    <section class="quiz-section" id="quiz-section" aria-label="Sound bath preference quiz">
      <!-- Progress indicator -->
      <div class="quiz-progress" id="quiz-progress">
        <div class="quiz-progress-bar" role="progressbar" aria-valuenow="1" aria-valuemin="1" aria-valuemax="5" aria-label="Quiz progress">
          <div class="quiz-progress-fill" id="quiz-progress-fill"></div>
        </div>
        <div class="quiz-progress-label" id="quiz-progress-label" aria-live="polite">Question 1 of 5</div>
      </div>

      <!-- Q1: Experience -->
      <div class="quiz-question" data-question="0" role="group" aria-label="Question 1: Experience level">
        <div class="quiz-q-num">i.</div>
        <h2 class="quiz-q-title">How familiar are you with <em>sound baths?</em></h2>
        <div class="quiz-options" role="listbox" aria-label="Select your experience level">
          <button class="quiz-option" data-value="first" data-q="experience">
            <span class="quiz-option-label">This would be my first</span>
            <span class="quiz-option-hint">I'm curious but I've never been</span>
          </button>
          <button class="quiz-option" data-value="few" data-q="experience">
            <span class="quiz-option-label">I've been to a few</span>
            <span class="quiz-option-hint">I know the basics, want to go deeper</span>
          </button>
          <button class="quiz-option" data-value="regular" data-q="experience">
            <span class="quiz-option-label">I'm a regular</span>
            <span class="quiz-option-hint">I have a practice and I know what I like</span>
          </button>
        </div>
      </div>

      <!-- Q2: Goal -->
      <div class="quiz-question" data-question="1" hidden role="group" aria-label="Question 2: What you're seeking">
        <div class="quiz-q-num">ii.</div>
        <h2 class="quiz-q-title">What are you hoping to <em>feel?</em></h2>
        <div class="quiz-options" role="listbox" aria-label="Select what you're seeking">
          <button class="quiz-option" data-value="rest" data-q="goal">
            <span class="quiz-option-label">Deep rest</span>
            <span class="quiz-option-hint">I want to zone out and maybe fall asleep</span>
          </button>
          <button class="quiz-option" data-value="release" data-q="goal">
            <span class="quiz-option-label">Something to move through</span>
            <span class="quiz-option-hint">Emotional release, catharsis</span>
          </button>
          <button class="quiz-option" data-value="curious" data-q="goal">
            <span class="quiz-option-label">Just curious what it's like</span>
            <span class="quiz-option-hint">No specific goal, open to whatever happens</span>
          </button>
          <button class="quiz-option" data-value="ceremonial" data-q="goal">
            <span class="quiz-option-label">Something ceremonial</span>
            <span class="quiz-option-hint">Spiritual, intentional, set with ritual</span>
          </button>
        </div>
      </div>

      <!-- Q3: Setting -->
      <div class="quiz-question" data-question="2" hidden role="group" aria-label="Question 3: Preferred setting">
        <div class="quiz-q-num">iii.</div>
        <h2 class="quiz-q-title">What setting feels <em>right?</em></h2>
        <div class="quiz-options" role="listbox" aria-label="Select your preferred setting">
          <button class="quiz-option" data-value="group" data-q="setting">
            <span class="quiz-option-label">Group energy</span>
            <span class="quiz-option-hint">The more the merrier — shared space</span>
          </button>
          <button class="quiz-option" data-value="small" data-q="setting">
            <span class="quiz-option-label">Small and quiet</span>
            <span class="quiz-option-hint">Intimate, limited group, low-key</span>
          </button>
          <button class="quiz-option" data-value="private" data-q="setting">
            <span class="quiz-option-label">Private, just me</span>
            <span class="quiz-option-hint">1-on-1 or with a partner</span>
          </button>
          <button class="quiz-option" data-value="outdoor" data-q="setting">
            <span class="quiz-option-label">Outdoors if possible</span>
            <span class="quiz-option-hint">Under sky, in a garden, by water</span>
          </button>
        </div>
      </div>

      <!-- Q4: Budget -->
      <div class="quiz-question" data-question="3" hidden role="group" aria-label="Question 4: Budget">
        <div class="quiz-q-num">iv.</div>
        <h2 class="quiz-q-title">What's your <em>budget?</em></h2>
        <div class="quiz-options" role="listbox" aria-label="Select your budget">
          <button class="quiz-option" data-value="under30" data-q="budget">
            <span class="quiz-option-label">Under $30</span>
            <span class="quiz-option-hint">Community, donation-based, or accessible pricing</span>
          </button>
          <button class="quiz-option" data-value="30to60" data-q="budget">
            <span class="quiz-option-label">$30 to $60</span>
            <span class="quiz-option-hint">Standard group session range</span>
          </button>
          <button class="quiz-option" data-value="unlimited" data-q="budget">
            <span class="quiz-option-label">I'll pay for the right experience</span>
            <span class="quiz-option-hint">Private sessions, retreats, no ceiling</span>
          </button>
        </div>
      </div>

      <!-- Q5: Location -->
      <div class="quiz-question" data-question="4" hidden role="group" aria-label="Question 5: Your location">
        <div class="quiz-q-num">v.</div>
        <h2 class="quiz-q-title">Where are <em>you?</em></h2>
        <div class="quiz-options" role="listbox" aria-label="Select your city or choose to travel">
          {pilotCities.map((city) => (
            <button class="quiz-option" data-value={city.slug} data-q="location">
              <span class="quiz-option-label">{city.name}</span>
              <span class="quiz-option-hint">Show sessions in this city</span>
            </button>
          ))}
          <button class="quiz-option" data-value="any" data-q="location">
            <span class="quiz-option-label">Open to traveling</span>
            <span class="quiz-option-hint">Show me the best matches anywhere</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ── Loading state ── -->
    <section class="quiz-loading" id="quiz-loading" hidden>
      <div class="quiz-loading-spinner"></div>
      <p class="quiz-loading-text">Finding sessions that fit your answers…</p>
    </section>

    <!-- ── Results section (rendered client-side) ── -->
    <section class="quiz-results" id="quiz-results" hidden aria-live="polite" aria-label="Quiz results">
      <div class="quiz-results-head">
        <div class="quiz-results-num">✦</div>
        <h2 class="quiz-results-title">Your <em>matches.</em></h2>
      </div>
      <div class="quiz-prose" id="quiz-prose"></div>
      <div class="quiz-sessions" id="quiz-sessions"></div>
      <div class="quiz-results-footer">
        <button class="quiz-retake" id="quiz-retake">Take the quiz again</button>
      </div>
    </section>

    <!-- ── Error / fallback section ── -->
    <section class="quiz-error" id="quiz-error" hidden>
      <h2>We're having trouble loading sessions right now.</h2>
      <p>Browse cities directly instead — each city page has vetted sessions and venues.</p>
      <div class="quiz-error-cities">
        {pilotCities.map((city) => (
          <a href={`/cities/${city.slug}`} class="quiz-error-city">{city.name}</a>
        ))}
      </div>
    </section>

    <Footer />
  </main>
</Layout>

<style>
  /* ── Intro ── */
  .quiz-intro {
    max-width: 1440px;
    margin: 0 auto;
    padding: 160px 6vw 60px;
    text-align: center;
  }
  .quiz-intro-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--clay);
    margin-bottom: 28px;
    display: inline-block;
  }
  .quiz-intro-eyebrow::before,
  .quiz-intro-eyebrow::after { content: "—"; margin: 0 12px; color: var(--clay); }
  .quiz-intro h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(48px, 6.5vw, 88px);
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--ink);
    max-width: 760px;
    margin: 0 auto 24px;
    font-variation-settings: "opsz" 144;
  }
  .quiz-intro h1 em { font-style: italic; color: var(--clay); }
  .quiz-intro-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink-mid);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.4;
    font-variation-settings: "opsz" 72;
  }

  /* ── Progress ── */
  .quiz-section {
    max-width: 840px;
    margin: 0 auto;
    padding: 40px 6vw 120px;
  }
  .quiz-progress {
    margin-bottom: 64px;
  }
  .quiz-progress-bar {
    height: 2px;
    background: var(--rule);
    border-radius: 1px;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .quiz-progress-fill {
    height: 100%;
    background: var(--clay);
    width: 20%;
    transition: width 0.4s ease;
  }
  .quiz-progress-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ── Question ── */
  .quiz-question {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .quiz-q-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 48px;
    color: var(--clay);
    line-height: 0.8;
  }
  .quiz-q-title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(36px, 4.5vw, 56px);
    line-height: 0.95;
    letter-spacing: -1.5px;
    color: var(--ink);
    font-variation-settings: "opsz" 144;
  }
  .quiz-q-title em { font-style: italic; color: var(--clay); }

  /* ── Options ── */
  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }
  .quiz-option {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 24px 28px;
    background: var(--linen);
    border: 1px solid var(--rule);
    border-radius: 12px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, transform 0.15s;
    text-align: left;
    font-family: inherit;
  }
  .quiz-option:hover {
    background: var(--bone-2);
    border-color: var(--clay);
    transform: translateX(4px);
  }
  .quiz-option:active { transform: translateX(2px) scale(0.99); }
  .quiz-option:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }
  .quiz-option-label {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
    font-variation-settings: "opsz" 72;
  }
  .quiz-option-hint {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-soft);
    font-variation-settings: "opsz" 72;
  }

  /* ── Loading ── */
  .quiz-loading {
    max-width: 840px;
    margin: 0 auto;
    padding: 80px 6vw 120px;
    text-align: center;
  }
  .quiz-loading-spinner {
    width: 40px;
    height: 40px;
    border: 2px solid var(--rule);
    border-top-color: var(--clay);
    border-radius: 50%;
    margin: 0 auto 24px;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .quiz-loading-text {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    color: var(--ink-mid);
    font-variation-settings: "opsz" 72;
  }

  /* ── Results ── */
  .quiz-results {
    max-width: 920px;
    margin: 0 auto;
    padding: 60px 6vw 120px;
  }
  .quiz-results-head {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 32px;
    align-items: end;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 48px;
  }
  .quiz-results-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 48px;
    color: var(--clay);
    line-height: 0.8;
  }
  .quiz-results-title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--ink);
    font-variation-settings: "opsz" 144;
  }
  .quiz-results-title em { font-style: italic; color: var(--clay); }

  .quiz-prose {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.75;
    color: var(--ink-mid);
    max-width: 680px;
    margin-bottom: 56px;
    font-variation-settings: "opsz" 72;
  }

  /* ── Session cards in results ── */
  .quiz-sessions {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .quiz-session-card {
    padding: 28px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .quiz-session-card:first-child { border-top: 1px solid var(--rule-soft); }
  .quiz-session-rank {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 28px;
    color: var(--clay);
    line-height: 1;
    margin-bottom: 8px;
  }
  .quiz-session-name {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 22px;
    color: var(--ink);
    letter-spacing: -0.3px;
    margin-bottom: 4px;
    font-variation-settings: "opsz" 72;
  }
  .quiz-session-hood {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: 12px;
  }
  .quiz-session-modalities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }
  .quiz-session-modality {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--clay);
    background: var(--linen);
    padding: 4px 10px;
    border-radius: 100px;
    border: 1px solid var(--rule);
  }
  .quiz-session-desc {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--ink-mid);
    line-height: 1.6;
    max-width: 640px;
    margin-bottom: 12px;
  }
  .quiz-session-meta {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .quiz-session-meta-item {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink-mid);
  }
  .quiz-session-meta-label {
    color: var(--ink-soft);
    font-size: 11px;
    margin-right: 4px;
  }
  .quiz-session-meta-value {
    color: var(--ink);
    font-weight: 500;
  }
  .quiz-session-book {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .quiz-session-book:hover { color: var(--clay); }
  .quiz-session-book .arrow {
    font-size: 14px;
    transition: transform 0.2s;
  }
  .quiz-session-book:hover .arrow { transform: translateX(3px); }

  /* ── Results footer ── */
  .quiz-results-footer {
    text-align: center;
    margin-top: 56px;
  }
  .quiz-retake {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 28px;
    background: var(--ink);
    color: var(--bone);
    border: none;
    border-radius: 100px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }
  .quiz-retake:hover { background: var(--clay); }

  /* ── Error / fallback ── */
  .quiz-error {
    max-width: 840px;
    margin: 0 auto;
    padding: 80px 6vw 120px;
    text-align: center;
  }
  .quiz-error h2 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 36px;
    color: var(--ink);
    margin-bottom: 16px;
    font-variation-settings: "opsz" 72;
  }
  .quiz-error p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--ink-mid);
    margin-bottom: 32px;
  }
  .quiz-error-cities {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .quiz-error-city {
    padding: 10px 22px;
    background: var(--linen);
    border: 1px solid var(--rule);
    border-radius: 100px;
    font-family: var(--serif);
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
    font-variation-settings: "opsz" 72;
  }
  .quiz-error-city:hover { border-color: var(--clay); color: var(--clay); }

  @media (max-width: 640px) {
    .quiz-intro { padding-top: 120px; }
    .quiz-option { padding: 18px 22px; }
    .quiz-option-label { font-size: 18px; }
    .quiz-results-head { grid-template-columns: 1fr; gap: 12px; }
  }
</style>

<script>
  // ── Quiz configuration ──
  const CMS_API = 'https://sounddip-cms.buzzuw2.workers.dev';
  const WORKER_URL = 'https://quiz-recommend.buzzuw2.workers.dev';

  // ── State ──
  const answers: Record<string, string> = {};
  let currentQuestion = 0;
  const totalQuestions = 5;

  // ── DOM refs ──
  const progressFill = document.getElementById('quiz-progress-fill')!;
  const progressLabel = document.getElementById('quiz-progress-label')!;
  const questions = Array.from(document.querySelectorAll<HTMLElement>('.quiz-question'));
  const quizSection = document.getElementById('quiz-section')!;
  const loadingSection = document.getElementById('quiz-loading')!;
  const resultsSection = document.getElementById('quiz-results')!;
  const errorSection = document.getElementById('quiz-error')!;
  const proseDiv = document.getElementById('quiz-prose')!;
  const sessionsDiv = document.getElementById('quiz-sessions')!;
  const retakeBtn = document.getElementById('quiz-retake')!;

  // ── Quiz flow ──
  function showQuestion(index: number) {
    questions.forEach((q, i) => {
      q.hidden = i !== index;
    });
    currentQuestion = index;
    const pct = ((index + 1) / totalQuestions) * 100;
    progressFill.style.width = `${pct}%`;
    progressLabel.textContent = `Question ${index + 1} of ${totalQuestions}`;
    // Update ARIA
    const progressbar = document.querySelector('.quiz-progress-bar');
    if (progressbar) progressbar.setAttribute('aria-valuenow', String(index + 1));
  }

  function selectAnswer(q: string, value: string) {
    answers[q] = value;
    if (currentQuestion < totalQuestions - 1) {
      showQuestion(currentQuestion + 1);
    } else {
      submitQuiz();
    }
  }

  // ── Scoring logic ──
  interface Listing {
    id: number;
    name: string;
    slug: string;
    city: any;
    neighborhood?: string;
    modalityTags?: string[];
    modalityDescription?: string;
    duration?: string;
    price?: string;
    bookingUrl?: string;
    practitionerBio?: string;
    sessionDescription?: string;
    listingStatus?: string;
  }

  // Modality → goal mapping
  const goalModalityMap: Record<string, string[]> = {
    rest: ['crystal', 'voice', 'tibetan-bowls'],
    release: ['gong', 'breathwork'],
    curious: ['mixed', 'other', 'crystal'],
    ceremonial: ['gong', 'voice', 'brass'],
  };

  // Setting → keywords
  const settingKeywords: Record<string, string[]> = {
    group: ['group', 'community', 'public', 'drop-in', 'weekly', 'open'],
    small: ['small', 'intimate', 'limited', 'private group', 'boutique'],
    private: ['private', '1-on-1', 'one-on-one', 'individual', 'couples', 'solo'],
    outdoor: ['outdoor', 'garden', 'park', 'lake', 'nature', 'beach', 'under the stars', 'outside', 'water', 'forest', 'desert'],
  };

  // Experience → keywords
  const experienceBeginnerKeywords = ['beginner', 'introductory', 'first', 'all levels', 'community', 'drop-in', 'welcome', 'no experience'];
  const experienceAdvancedKeywords = ['advanced', 'deep', 'intensive', 'training', 'certification', 'retreat', 'private'];

  function parseMinPrice(priceStr: string): number | null {
    if (!priceStr || priceStr === 'Not published') return null;
    const match = priceStr.match(/\$(\d+(?:\.\d+)?)/);
    return match ? parseFloat(match[1]) : null;
  }

  function scoreListing(listing: Listing, answers: Record<string, string>): number {
    let score = 0;
    const desc = `${listing.sessionDescription || ''} ${listing.modalityDescription || ''} ${listing.practitionerBio || ''}`.toLowerCase();
    const tags = listing.modalityTags || [];

    // Q1: Experience (20 pts)
    if (answers.experience === 'first') {
      const beginnerMatch = experienceBeginnerKeywords.some(kw => desc.includes(kw));
      const advancedMatch = experienceAdvancedKeywords.some(kw => desc.includes(kw));
      if (beginnerMatch) score += 20;
      else if (advancedMatch) score -= 10;
      else score += 5; // neutral default
    } else if (answers.experience === 'regular') {
      const advancedMatch = experienceAdvancedKeywords.some(kw => desc.includes(kw));
      if (advancedMatch) score += 15;
      else score += 8;
    } else {
      score += 10; // "been to a few" — neutral
    }

    // Q2: Goal (20 pts)
    const targetModalities = goalModalityMap[answers.goal] || [];
    if (targetModalities.length > 0) {
      const modalityMatches = tags.filter(t => targetModalities.includes(t)).length;
      score += modalityMatches * 7; // up to 21, capped at 20
      // Also check description for modality keywords
      const goalKeywords: Record<string, string[]> = {
        rest: ['rest', 'sleep', 'relax', 'calm', 'soft', 'crystal bowl'],
        release: ['release', 'cathartic', 'gong', 'intense', 'breathwork', 'move through'],
        curious: ['introductory', 'beginner', 'community', 'group', 'all levels'],
        ceremonial: ['ceremony', 'ceremonial', 'ritual', 'spiritual', 'cacao', 'intention', 'sacred'],
      };
      const goalKws = goalKeywords[answers.goal] || [];
      const kwMatches = goalKws.filter(kw => desc.includes(kw)).length;
      score += Math.min(kwMatches * 4, 8);
    }
    score = Math.min(score, 40); // cap Q1+Q2 at 40

    // Q3: Setting (20 pts)
    const targetSettingKws = settingKeywords[answers.setting] || [];
    if (targetSettingKws.length > 0) {
      const settingMatches = targetSettingKws.filter(kw => desc.includes(kw)).length;
      score += Math.min(settingMatches * 10, 20);
    }

    // Q4: Budget (20 pts)
    const minPrice = parseMinPrice(listing.price || '');
    if (answers.budget === 'under30') {
      if (minPrice !== null && minPrice <= 30) score += 20;
      else if (minPrice !== null && minPrice <= 40) score += 10;
      else if (desc.includes('free') || desc.includes('donation')) score += 20;
      else if (minPrice === null) score += 5; // unknown price, small credit
    } else if (answers.budget === '30to60') {
      if (minPrice !== null && minPrice >= 30 && minPrice <= 60) score += 20;
      else if (minPrice !== null && minPrice <= 60) score += 15;
      else if (minPrice === null) score += 8;
    } else {
      // unlimited — no filtering, but boost higher-end sessions slightly
      if (minPrice !== null && minPrice > 60) score += 10;
      else score += 12;
    }

    return Math.min(score, 100);
  }

  // ── CMS fetch ──
  async function fetchListings(citySlug: string | 'any'): Promise<Listing[]> {
    let cityFilter = '';
    if (citySlug !== 'any') {
      // Resolve city slug to ID
      const cityRes = await fetch(`${CMS_API}/api/cities?where[slug][equals]=${citySlug}&limit=1`);
      const cityData = await cityRes.json();
      if (!cityData.docs?.[0]?.id) return [];
      cityFilter = `&where[city][equals]=${cityData.docs[0].id}`;
    }

    // Fetch published listings
    const listingsRes = await fetch(`${CMS_API}/api/listings?where[_status][equals]=published${cityFilter}&limit=100&depth=1`);
    const listingsData = await listingsRes.json();
    return (listingsData.docs || []).filter((l: Listing) =>
      ['active', 'active-secondary'].includes(l.listingStatus || '')
    );
  }

  // ── Submit quiz ──
  async function submitQuiz() {
    quizSection.hidden = true;
    loadingSection.hidden = false;

    try {
      // Fetch listings from CMS
      let listings = await fetchListings(answers.location as string);

      // If "open to traveling", fetch from all pilot cities
      if (answers.location === 'any') {
        const citySlugs = Array.from(document.querySelectorAll('[data-q="location"]'))
          .map(el => el.getAttribute('data-value')!)
          .filter(v => v !== 'any');
        const allListings: Listing[] = [];
        for (const slug of citySlugs) {
          try {
            const cityListings = await fetchListings(slug);
            allListings.push(...cityListings);
          } catch { /* skip cities that fail */ }
        }
        listings = allListings;
      }

      if (listings.length === 0) {
        showError();
        return;
      }

      // Score listings
      const scored = listings
        .map(l => ({ listing: l, score: scoreListing(l, answers) }))
        .sort((a, b) => b.score - a.score);

      const topListings = scored.slice(0, 5).map(s => s.listing);

      if (topListings.length === 0) {
        showError();
        return;
      }

      // Try to get personalized prose from DeepSeek via Worker
      let prose = '';
      try {
        const workerRes = await fetch(WORKER_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            answers,
            listings: topListings.map(l => ({
              name: l.name,
              city: typeof l.city === 'object' ? l.city?.name : l.city,
              neighborhood: l.neighborhood,
              modalityTags: l.modalityTags,
              sessionDescription: l.sessionDescription,
              price: l.price,
              bookingUrl: l.bookingUrl,
            })),
          }),
          signal: AbortSignal.timeout(15000),
        });

        if (workerRes.ok) {
          const data = await workerRes.json();
          prose = data.prose || '';
        }
      } catch {
        // Worker unreachable — use fallback prose
      }

      // Fallback prose if Worker didn't return anything
      if (!prose) {
        prose = generateFallbackProse(answers, topListings);
      }

      // Render results
      renderResults(prose, topListings);
      loadingSection.hidden = true;
      resultsSection.hidden = false;
      resultsSection.scrollIntoView({ behavior: 'smooth' });

    } catch {
      showError();
    }
  }

  function generateFallbackProse(answers: Record<string, string>, listings: Listing[]): string {
    const goalTexts: Record<string, string> = {
      rest: 'deep rest',
      release: 'something to move through',
      curious: 'a first experience',
      ceremonial: 'something ceremonial',
    };
    const goalText = goalTexts[answers.goal] || 'a sound bath';
    const cityNames = [...new Set(listings.map(l => typeof l.city === 'object' ? l.city?.name : l.city))];
    const cityText = cityNames.length === 1 ? cityNames[0] : cityNames.slice(0, -1).join(', ') + ' and ' + cityNames[cityNames.length - 1];

    return `Based on your answers, these sessions in ${cityText} fit what you're looking for. ${listings.length === 1 ? 'This one matches' : 'These match'} your budget and preferred setting, and ${answers.experience === 'first' ? 'they work well for first-timers' : answers.experience === 'regular' ? 'they offer depth for someone with an existing practice' : 'they suit someone who has been a few times'}. You said you wanted ${goalText} — start with the first match below and book directly.`;
  }

  function renderResults(prose: string, listings: Listing[]) {
    proseDiv.textContent = prose;

    sessionsDiv.innerHTML = listings.map((listing, i) => {
      const num = String(i + 1).padStart(2, '0');
      const cityName = typeof listing.city === 'object' ? listing.city?.name : listing.city || '';
      const tags = (listing.modalityTags || []).map(tag =>
        `<span class="quiz-session-modality">${tag.replace(/-/g, ' ')}</span>`
      ).join('');
      const bookLink = listing.bookingUrl && listing.bookingUrl !== 'N/A'
        ? `<a href="${listing.bookingUrl}" class="quiz-session-book" target="_blank" rel="noopener noreferrer">Book a session <span class="arrow">↗</span></a>`
        : '';
      const desc = listing.sessionDescription
        ? `<p class="quiz-session-desc">${listing.sessionDescription}</p>`
        : '';
      const price = listing.price && listing.price !== 'Not published'
        ? `<span class="quiz-session-meta-item"><span class="quiz-session-meta-label">Price</span> <span class="quiz-session-meta-value">${listing.price}</span></span>`
        : '';
      const duration = listing.duration && listing.duration !== 'Not published'
        ? `<span class="quiz-session-meta-item"><span class="quiz-session-meta-label">Duration</span> <span class="quiz-session-meta-value">${listing.duration}</span></span>`
        : '';
      const cityLink = cityName
        ? `<a href="/cities/${(typeof listing.city === 'object' ? listing.city?.slug : '') || ''}" style="color: inherit; text-decoration: none;">${cityName}</a>`
        : '';

      return `
        <div class="quiz-session-card">
          <div class="quiz-session-rank">${num}</div>
          <h3 class="quiz-session-name">${listing.name}</h3>
          <div class="quiz-session-hood">${listing.neighborhood ? listing.neighborhood + ' · ' : ''}${cityName}</div>
          ${tags ? `<div class="quiz-session-modalities">${tags}</div>` : ''}
          ${desc}
          <div class="quiz-session-meta">${duration}${price}</div>
          ${bookLink}
        </div>
      `;
    }).join('');
  }

  function showError() {
    loadingSection.hidden = true;
    quizSection.hidden = true;
    errorSection.hidden = false;
    errorSection.scrollIntoView({ behavior: 'smooth' });
  }

  function resetQuiz() {
    answers.length = 0;
    Object.keys(answers).forEach(k => delete answers[k]);
    currentQuestion = 0;
    showQuestion(0);
    resultsSection.hidden = true;
    errorSection.hidden = true;
    quizSection.hidden = false;
    quizSection.scrollIntoView({ behavior: 'smooth' });
  }

  // ── Event listeners ──
  document.querySelectorAll('.quiz-option').forEach(btn => {
    btn.setAttribute('role', 'option');
    btn.setAttribute('tabindex', '0');
    btn.addEventListener('click', () => {
      const q = btn.getAttribute('data-q')!;
      const value = btn.getAttribute('data-value')!;
      selectAnswer(q, value);
    });
    // Keyboard: Enter or Space to select
    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const q = btn.getAttribute('data-q')!;
        const value = btn.getAttribute('data-value')!;
        selectAnswer(q, value);
      }
    });
  });

  retakeBtn.addEventListener('click', resetQuiz);

  // ── Init ──
  showQuestion(0);
</script>

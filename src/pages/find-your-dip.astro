---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';
import NearbyMap from '../components/NearbyMap.astro';
---

<Layout
  title="Find Your Sound Bath — Sound Dip"
  description="Enter your ZIP code to find verified sound bath sessions near you, within 25, 50, or 100 miles."
  canonical="/find-your-dip"
>
  <main>
    <Topbar />
    <section class="fyd">
      <header class="fyd-head">
        <div class="fyd-num">≈</div>
        <h1>Find your <em>dip.</em></h1>
        <p class="fyd-sub">Enter your ZIP code to see verified sound bath sessions near you, within 25, 50, or 100 miles.</p>
      </header>

      <NearbyMap />
    </section>
    <Footer />
  </main>
</Layout>

<style>
  .fyd {
    max-width: 1440px;
    margin: 0 auto;
    padding: 140px 6vw 100px;
  }
  .fyd-head {
    margin-bottom: 56px;
  }
  .fyd-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 48px;
    color: var(--clay);
    line-height: 0.8;
    margin-bottom: 24px;
  }
  .fyd-head h1 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(44px, 6vw, 72px);
    line-height: 0.95;
    letter-spacing: -2px;
    color: var(--ink);
    margin-bottom: 24px;
    font-variation-settings: "opsz" 144;
  }
  .fyd-head h1 em { font-style: italic; color: var(--clay); }
  .fyd-sub {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 20px;
    color: var(--ink-mid);
    max-width: 560px;
    line-height: 1.4;
    font-variation-settings: "opsz" 72;
  }
  @media (max-width: 640px) {
    .fyd { padding: 100px 6vw 60px; }
  }
</style>
